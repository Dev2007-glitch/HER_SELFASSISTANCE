# HER AI Assistant - API Key Configuration
# You can use any of Google Gemini, Groq, or OpenAI keys

# Google Gemini API Key (Get free at https://aistudio.google.com/app/apikey)
VITE_GOOGLE_API_KEY=

# Groq API Key (Get free at https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=
